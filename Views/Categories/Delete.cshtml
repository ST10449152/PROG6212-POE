@model RaceDayMVC.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h1 class="fw-bold text-danger">Delete Category</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this category?
        This action cannot be undone.
    </div>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4>@Model.CategoryName</h4>

            <p>
                <strong>Distance:</strong>
                @Model.DistanceKM km
            </p>

            <p>
                <strong>Maximum Participants:</strong>
                @Model.MaxParticipants
            </p>

            <p>
                <strong>Entrance Fee:</strong>
                R @Model.EntranceFee.ToString("N2")
            </p>

            <div class="alert alert-info">
                Categories with existing enrolments cannot be deleted.
            </div>

            <form asp-controller="Categories"
                  asp-action="Delete"
                  asp-route-id="@Model.CategoryID"
                  asp-route-eventId="@Model.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index"
                   asp-route-eventId="@Model.EventID"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>