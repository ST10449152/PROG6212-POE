@model List<RaceDayMVC.Models.CategoryFormViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = ViewBag.EventID;
}

<div class="container mt-4">
    <h1 class="fw-bold">Manage Event Categories</h1>

    <p class="lead text-muted">
        Create and manage categories for this race.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Categories"
           asp-action="Create"
           asp-route-eventId="@eventId"
           class="btn btn-success">
            + Add Category
        </a>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No categories have been created for this event yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h4 class="fw-bold">
                                @category.CategoryName
                            </h4>

                            <p>
                                <strong>Distance:</strong>
                                @category.DistanceKM km
                            </p>

                            <p>
                                <strong>Maximum Participants:</strong>
                                @category.MaxParticipants
                            </p>

                            <p>
                                <strong>Entrance Fee:</strong>
                                R @category.EntranceFee.ToString("N2")
                            </p>

                            <div class="d-flex gap-2">
                                <a asp-controller="Categories"
                                   asp-action="Edit"
                                   asp-route-id="@category.CategoryID"
                                   asp-route-eventId="@eventId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Categories"
                                   asp-action="Delete"
                                   asp-route-id="@category.CategoryID"
                                   asp-route-eventId="@eventId"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>