@model RaceDayMVC.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <h1 class="fw-bold">Edit Category</h1>

    <p class="text-muted">
        Update the category details.
    </p>

    <form asp-controller="Categories"
          asp-action="Edit"
          asp-route-id="@Model.CategoryID"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="CategoryID" type="hidden" />
        <input asp-for="EventID" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKM" class="form-label"></label>
            <input asp-for="DistanceKM" type="number"
                   step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="DistanceKM"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants" type="number"
                   min="1" class="form-control" />
            <span asp-validation-for="MaxParticipants"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EntranceFee" class="form-label"></label>
            <input asp-for="EntranceFee" type="number"
                   step="0.01" min="0" class="form-control" />
            <span asp-validation-for="EntranceFee"
                  class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                Save Changes
            </button>

            <a asp-action="Index"
               asp-route-eventId="@Model.EventID"
               class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}