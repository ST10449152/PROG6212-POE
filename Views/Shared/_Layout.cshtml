@using Microsoft.AspNetCore.Http

@{
    // Read the logged-in user's details.
    var userId = Context.Session.GetInt32("UserID");
    var firstName = Context.Session.GetString("FirstName");
    var role = Context.Session.GetString("Role");
    var selectedMode = Context.Session.GetString("SelectedMode");

    bool isLoggedIn = userId.HasValue &&
                      !string.IsNullOrEmpty(role) &&
                      !string.IsNullOrEmpty(
                          Context.Session.GetString("ApiSessionCookie"));

    bool isOrganiser = isLoggedIn && role == "Organiser";

    // Determine where the Home link should lead.
    string homeController = "Home";

    if (isLoggedIn)
    {
        if (isOrganiser)
        {
            if (selectedMode == "Participant")
            {
                homeController = "Participant";
            }
            else if (selectedMode == "Organiser")
            {
                homeController = "Organiser";
            }
            else
            {
                homeController = "Mode";
            }
        }
        else
        {
            homeController = "Participant";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <script type="importmap"></script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDayMVC.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- RaceDay Brand -->
                <a class="navbar-brand fw-bold"
                   asp-controller="@homeController"
                   asp-action="Index">
                    RaceDay
                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse"
                     id="raceDayNavbar">

                    <ul class="navbar-nav">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="@homeController"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <!-- My Profile -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Profile"
                                   asp-action="Index">
                                    My Profile
                                </a>
                            </li>

                            @if (isOrganiser)
                            {
                                <!-- Only Organisers can switch modes -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Mode"
                                       asp-action="Index">
                                        Switch Mode
                                    </a>
                                </li>
                            }

                            <!-- Display the user's name and account role -->
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Welcome, @firstName (@role)
                                </span>
                            </li>

                            <!-- Logout -->
                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link text-dark">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <!-- Register -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>