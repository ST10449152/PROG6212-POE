@using Microsoft.AspNetCore.Http

@{
    // Read the logged-in user's session details.
    var userId = Context.Session.GetInt32("UserID");
    var firstName = Context.Session.GetString("FirstName");
    var role = Context.Session.GetString("Role");
    var selectedMode = Context.Session.GetString("SelectedMode");

    bool isLoggedIn = userId.HasValue &&
                      !string.IsNullOrEmpty(role) &&
                      !string.IsNullOrEmpty(
                          Context.Session.GetString("ApiSessionCookie"));

    bool isOrganiser = isLoggedIn && role == "Organiser";

    // Choose the correct home page for the user.
    string homeController = "Home";

    if (isLoggedIn)
    {
        if (isOrganiser)
        {
            if (selectedMode == "Participant")
            {
                homeController = "Participant";
            }
            else if (selectedMode == "Organiser")
            {
                homeController = "Organiser";
            }
            else
            {
                homeController = "Mode";
            }
        }
        else
        {
            homeController = "Participant";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- RaceDay styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDayMVC.styles.css"
          asp-append-version="true" />
</head>

<body class="raceday-body">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
            <div class="container">

                <!-- RaceDay brand -->
                <a class="navbar-brand raceday-brand"
                   asp-controller="@homeController"
                   asp-action="Index">
                    <span class="raceday-brand-icon">🏁</span>
                    RaceDay
                </a>

                <!-- Mobile navigation -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="raceDayNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="@homeController"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <!-- My Profile -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Profile"
                                   asp-action="Index">
                                    My Profile
                                </a>
                            </li>

                            @if (isOrganiser)
                            {
                                <!-- Organisers can change modes -->
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Mode"
                                       asp-action="Index">
                                        Switch Mode
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Account navigation -->
                    <div class="d-flex flex-column flex-lg-row
                                align-items-lg-center gap-2">

                        @if (isLoggedIn)
                        {
                            <span class="raceday-user-info">
                                Welcome, @firstName
                                <span class="raceday-role">
                                    @role
                                </span>
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm
                                               raceday-logout-btn">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-light btn-sm">
                                Login
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-primary btn-sm">
                                Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main page content -->
    <div class="container raceday-main">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="raceday-footer">
        <div class="container text-center">
            <p class="mb-1">
                &copy; 2026 RaceDay
            </p>

            <small>
                Run. Walk. Cycle. Achieve.
            </small>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>