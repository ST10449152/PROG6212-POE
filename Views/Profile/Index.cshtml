@model RaceDayMVC.Models.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h2 class="mb-4">My RaceDay Profile</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null)
    {
        <div class="alert alert-danger">
            @(ViewBag.ErrorMessage ?? "Profile information is unavailable.")
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Account Information</h4>
            </div>

            <div class="card-body">

                <div class="text-center mb-4">
                    <img src="@Url.Action("ProfilePicture", "Image", new { v = DateTime.UtcNow.Ticks })"
                         alt="My profile picture"
                         class="rounded-circle border"
                         style="width:150px;height:150px;object-fit:cover;"
                         onerror="this.style.display='none';document.getElementById('noProfileImage').style.display='block';" />

                    <p id="noProfileImage"
                       class="text-muted"
                       style="display:none;">
                        No profile picture uploaded yet.
                    </p>

                    <h5 class="mt-3">Profile Picture</h5>

                    <form asp-controller="Image"
                          asp-action="UploadProfilePicture"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <input type="file"
                                   name="image"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Upload Profile Picture
                        </button>
                    </form>

                    <small class="text-muted d-block mt-2">
                        JPG, PNG or WEBP. Maximum 5 MB.
                    </small>
                </div>

                <hr />

                <p><strong>User ID:</strong> @Model.UserID</p>
                <p><strong>First Name:</strong> @Model.FirstName</p>
                <p><strong>Last Name:</strong> @Model.LastName</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Account Type:</strong> @Model.Role</p>

                <p>
                    <strong>Account Created:</strong>
                    @Model.CreatedAt.ToString("dd MMMM yyyy")
                </p>

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="btn btn-warning mt-3">
                    Edit Profile
                </a>

            </div>
        </div>
    }
</div>