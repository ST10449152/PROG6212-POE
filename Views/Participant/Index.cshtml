@{
    ViewData["Title"] = "Participant Home";
}

<div class="container mt-4">

    <h1 class="fw-bold">Participant Home</h1>

    <p class="lead text-muted">
        Welcome to RaceDay! Discover upcoming races,
        register for events and track your results.
    </p>

    <div class="row g-4 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>Upcoming Races</h4>
                    <p>Browse available races and events.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>My Enrolments</h4>
                    <p>View the races you have entered.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>My Results</h4>
                    <p>Check your finishing times and positions.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>