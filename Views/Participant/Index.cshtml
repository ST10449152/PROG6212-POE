@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Participant Home";

    bool isParticipant =
        Context.Session.GetString("Role") == "Participant";
}

<div class="container mt-4">

    <h1 class="fw-bold">Participant Home</h1>

    <p class="lead text-muted">
        Discover upcoming races, enrol in events
        and track your results.
    </p>

    <div class="row g-4 mt-3">

        <!-- Upcoming Races -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">

                    <h4>Upcoming Races</h4>
                    <p>Browse available races and events.</p>

                    <span class="badge bg-primary align-self-start mb-3">
                        @Model.Count upcoming events
                    </span>

                    <a href="#upcoming-races"
                       class="btn btn-primary mt-auto">
                        Browse Races
                    </a>

                </div>
            </div>
        </div>

        <!-- My Enrolments -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">

                    <h4>My Enrolments</h4>
                    <p>View the races you have entered.</p>

                    @if (isParticipant)
                    {
                        <a asp-controller="MyEnrolments"
                           asp-action="Index"
                           class="btn btn-outline-primary mt-auto">
                            View My Enrolments
                        </a>
                    }
                    else
                    {
                        <span class="text-muted mt-auto">
                            Available to participant accounts.
                        </span>
                    }

                </div>
            </div>
        </div>

        <!-- My Results -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">

                    <h4>My Results</h4>
                    <p>Check your finishing times and positions.</p>

                    @if (isParticipant)
                    {
                        <a asp-controller="MyResults"
                           asp-action="Index"
                           class="btn btn-outline-primary mt-auto">
                            View My Results
                        </a>
                    }
                    else
                    {
                        <span class="text-muted mt-auto">
                            Available to participant accounts.
                        </span>
                    }

                </div>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <!-- Upcoming Race Events -->
    <h2 id="upcoming-races" class="fw-bold mb-4">
        Upcoming Race Events
    </h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">
            There are currently no upcoming race events available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var race in Model)
            {
                <div class="col-md-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <h4 class="card-title fw-bold">
                                @race.EventName
                            </h4>

                            <span class="badge bg-primary align-self-start mb-3">
                                @race.EventType
                            </span>

                            <p>
                                <strong>Date:</strong>
                                @(race.EventDate.ToString("dd MMMM yyyy"))
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @race.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @race.DistanceKM km
                            </p>

                            <p>
                                <strong>Start Time:</strong>
                                @(race.StartTime.ToString(@"hh\:mm"))
                            </p>

                            <p class="text-muted">
                                @race.Description
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Details"
                               asp-route-id="@race.EventID"
                               class="btn btn-primary mt-auto">
                                View Details
                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>