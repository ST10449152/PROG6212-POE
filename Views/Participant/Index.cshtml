@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Races";

    string search = ViewBag.Search ?? "";
    string eventType = ViewBag.EventType ?? "";
    string location = ViewBag.Location ?? "";
}

<div class="container mt-4">

    <h1 class="fw-bold">Upcoming Race Events</h1>

    <p class="lead text-muted">
        Browse upcoming races and find an event to join.
    </p>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">Filter Race Events</h4>

            <form asp-controller="Participant"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label for="search" class="form-label">
                            Event Name
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search by event name" />
                    </div>

                    <div class="col-md-4">
                        <label for="eventType" class="form-label">
                            Event Type
                        </label>

                        <select id="eventType"
                                name="eventType"
                                class="form-select">

                            <option value="">All Event Types</option>

                            <option value="Run"
                                    selected="@(eventType == "Run")">
                                Run
                            </option>

                            <option value="Walk"
                                    selected="@(eventType == "Walk")">
                                Walk
                            </option>

                            <option value="Cycle"
                                    selected="@(eventType == "Cycle")">
                                Cycle
                            </option>

                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="location" class="form-label">
                            Location
                        </label>

                        <input type="text"
                               id="location"
                               name="location"
                               value="@location"
                               class="form-control"
                               placeholder="e.g. Johannesburg" />
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">

                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Clear Filters
                    </a>

                </div>

            </form>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No upcoming race events match your search.
            Try changing or clearing the filters.
        </div>
    }
    else
    {
        <h4 class="mb-3">
            Available Events (@Model.Count)
        </h4>

        <div class="row g-4">

            @foreach (var race in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <h4 class="fw-bold">
                                @race.EventName
                            </h4>

                            <span class="badge bg-primary
                                         align-self-start mb-3">
                                @race.EventType
                            </span>

                            <p>
                                <strong>Date:</strong>
                                @race.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @race.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @race.DistanceKM km
                            </p>

                            <p>
                                <strong>Description:</strong>
                                @race.Description
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="Participant"
                                   asp-action="Details"
                                   asp-route-id="@race.EventID"
                                   class="btn btn-outline-primary">
                                    View Details
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>