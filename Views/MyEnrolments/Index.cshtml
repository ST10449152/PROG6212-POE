@model List<RaceDayMVC.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <h1 class="fw-bold">My Enrolments</h1>

    <p class="lead text-muted">
        View the races you have entered and check your enrolment status.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-4">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info mt-4">
            You have not enrolled in any races yet.
        </div>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-primary">
            Browse Upcoming Races
        </a>
    }
    else
    {
        <div class="row g-4 mt-3">

            @foreach (var item in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4 class="card-title fw-bold mb-3">
                                @item.EventName
                            </h4>

                            <p>
                                <strong>Event Date:</strong>
                                @(item.EventDate.ToString("dd MMMM yyyy"))
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @item.CategoryName
                            </p>

                            <p>
                                <strong>Enrolled On:</strong>
                                @(item.EnrollmentDate.ToString("dd MMMM yyyy"))
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.Status
                                    </span>
                                }
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-outline-primary mt-2">
                                View Race Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>