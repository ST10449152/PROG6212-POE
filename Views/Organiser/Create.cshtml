@model RaceDayMVC.Models.EventFormViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h1 class="fw-bold">Create New Event</h1>
    <p class="text-muted">
        Enter the details for your new race event.
    </p>

    <form asp-controller="Organiser"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="VenueID" class="form-label"></label>
                <input asp-for="VenueID" type="number"
                       min="1" class="form-control" />
                <div class="form-text">
                    Enter an existing Venue ID from RaceDayAPI.
                </div>
                <span asp-validation-for="VenueID"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date"
                       class="form-control" />
                <span asp-validation-for="EventDate"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time"
                       step="60" class="form-control" />
                <span asp-validation-for="StartTime"
                      class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" type="time"
                       step="60" class="form-control" />
                <span asp-validation-for="EndTime"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location"
                      class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="DistanceKM" class="form-label"></label>
                <input asp-for="DistanceKM" type="number"
                       step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="DistanceKM"
                      class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          rows="4" class="form-control"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="RouteDescription" class="form-label"></label>
                <textarea asp-for="RouteDescription"
                          rows="3" class="form-control"></textarea>
            </div>

            <div class="col-12">
                <label asp-for="RouteMapURL" class="form-label"></label>
                <input asp-for="RouteMapURL" class="form-control" />
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success">
                Create Event
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}