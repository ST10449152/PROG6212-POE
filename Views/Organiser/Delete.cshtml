@model RaceDayMVC.Models.EventFormViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <h1 class="fw-bold text-danger">Delete Event</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this event?
        This action cannot be undone.
    </div>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4>@Model.EventName</h4>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Event Type:</strong>
                @Model.EventType
            </p>

            <p>
                <strong>Distance:</strong>
                @Model.DistanceKM km
            </p>

            <div class="alert alert-info">
                Events with existing enrolments cannot be deleted.
            </div>

            <form asp-controller="Organiser"
                  asp-action="Delete"
                  asp-route-id="@Model.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>