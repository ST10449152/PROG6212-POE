@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <h1 class="fw-bold">Organiser Dashboard</h1>

    <p class="lead text-muted">
        Welcome to your RaceDay management dashboard.
        Manage events, participants and race results.
    </p>

    <div class="row g-4 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>My Events</h4>
                    <p>Create and manage your race events.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>Enrolments</h4>
                    <p>View participants registered for your races.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>Race Results</h4>
                    <p>Record finishing times and positions.</p>
                    <span class="text-muted">
                        Coming soon
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>